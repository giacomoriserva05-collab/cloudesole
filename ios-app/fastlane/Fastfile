# Firma l'app e la carica su TestFlight, da un runner macOS. Nessun Mac in
# mano a nessuno: la chiave API di App Store Connect basta a creare certificato
# e profilo di provisioning al volo (-allowProvisioningUpdates).
#
# Variabili d'ambiente, che arrivano dai segreti del repository:
#   ASC_KEY_ID      identificatore della chiave API
#   ASC_ISSUER_ID   identificatore dell'emittente
#   ASC_KEY_P8      contenuto del file .p8, per intero
#   ASC_TEAM_ID     identificatore della squadra di sviluppo
#   BUILD_NUMBER    progressivo: TestFlight rifiuta due build uguali

default_platform(:ios)

platform :ios do
  # Registra l'identificatore dell'app sul portale sviluppatori e crea la
  # scheda su App Store Connect. Sono i due passaggi che altrimenti andrebbero
  # fatti a mano nel sito: con la chiave API si fanno da qui, una volta sola.
  desc "Crea identificatore e scheda dell'app (da eseguire una volta)"
  lane :prepara do
    chiave = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: false,
      in_house: false
    )

    produce(
      api_key: chiave,
      app_identifier: "com.giacomoriserva.checkoutautofill",
      app_name: ENV.fetch("APP_NAME", "Checkout Autofill"),
      language: "Italian",
      sku: "checkoutautofill01",
      team_id: ENV.fetch("ASC_TEAM_ID"),
      skip_itc: false,
      skip_devcenter: false
    )
  end

  desc "Compila in Release e carica su TestFlight (tester interni)"
  lane :beta do
    chiave = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: false,
      in_house: false
    )

    numero = ENV.fetch("BUILD_NUMBER", "1")

    build_app(
      project: "CheckoutAutofill.xcodeproj",
      scheme: "CheckoutAutofill",
      configuration: "Release",
      export_method: "app-store",
      # Xcode si crea da sé certificato e profilo usando la chiave API.
      xcargs: "-allowProvisioningUpdates CURRENT_PROJECT_VERSION=#{numero}",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("ASC_TEAM_ID")
      },
      output_directory: "build",
      output_name: "CheckoutAutofill.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: chiave,
      # I tester interni non passano da nessuna revisione: la build è
      # disponibile appena Apple finisce di elaborarla.
      distribute_external: false,
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("CHANGELOG", "Build automatica da GitHub Actions.")
    )
  end
end
