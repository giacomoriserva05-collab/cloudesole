<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Notifiche remote: servono a farsi svegliare dal monitor sul computer
         anche ad app chiusa. "production" e' l'ambiente delle build firmate
         per App Store e TestFlight. -->
    <key>aps-environment</key>
    <string>production</string>
</dict>
</plist>
