{
  "manifest_version": 3,
  "name": "Checkout Autofill",
  "version": "1.0.0",
  "description": "Compila in automatico i campi di spedizione e pagamento nei checkout degli store online. I dati restano sul tuo computer.",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Checkout Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "fill-now": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Compila i campi del checkout nella scheda attiva"
    }
  }
}
